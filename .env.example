# LLM provider/model: "groq:<model-id>" or "ollama:<local-tag>"
LLM_MODEL=groq:qwen/qwen3.8-27b

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Ollama endpoint (only needed if not the default)
# OLLAMA_BASE_URL=http://localhost:11434

# Ollama context window. Prompts are ~2K tokens; qwen3.8's 262K default
# allocates a huge KV cache per request and slows local inference.
# OLLAMA_NUM_CTX=8192

# Max tokens per LLM response (bounds repetition loops / runaway output).
# OLLAMA_NUM_PREDICT=512
# GROQ_MAX_TOKENS=1024

# Parallel extraction calls. Groq free tier: keep low (8K tokens/min limit).
# LLM_MAX_CONCURRENCY=2

# Structured-output method: "json_schema" (default) or "function_calling"
# LLM_STRUCTURED_METHOD=json_schema
